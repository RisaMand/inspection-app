# Copy this file to .env and fill in real values. Never commit the real .env.
# (env.js fails fast at startup if DATABASE_URL or JWT_SECRET is missing.)

# --- Required ---

# Supabase Postgres connection string. Use the Session pooler URL, not the
# Direct connection URL -- the direct hostname only has an IPv6 (AAAA)
# record, which fails with ENOTFOUND on networks that don't resolve IPv6
# cleanly. Get this from Supabase's Connect panel > Session pooler tab.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Secret used to sign JWTs. Use a long random string, different per
# environment -- never reuse your local dev secret in production.
JWT_SECRET=replace-with-a-real-random-secret

# --- Optional (defaults shown are what env.js falls back to) ---

# development | production
NODE_ENV=development

# Port the backend listens on.
PORT=5000

# Set to "true" when connecting to Supabase (or any host requiring SSL).
# Any other value (including unset) is treated as false.
DATABASE_SSL=true

# How long an issued JWT stays valid. Any value the "ms" package or a plain
# number-of-seconds accepts (e.g. "8h", "30m", "3600").
JWT_EXPIRES_IN=8h

# The frontend origin allowed to call this API. Set to your real deployed
# frontend URL in production (e.g. https://your-app.vercel.app) --
# never a wildcard.
CORS_ORIGIN=http://localhost:5173

# bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=12

# Max size of a JSON request body (bytes, or a string like "10mb").
MAX_JSON_BODY_SIZE=10mb

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info